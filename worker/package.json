{
  "name": "contentguard-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute contentguard --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute contentguard --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.125.0"
  }
}
