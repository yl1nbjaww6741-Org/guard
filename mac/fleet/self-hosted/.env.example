# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored (see ../../.gitignore) - never commit it.

# --- MySQL (Fleet's backing store) ---
MYSQL_ROOT_PASSWORD=   # openssl rand -hex 24
MYSQL_DATABASE=fleet
MYSQL_USER=fleet
MYSQL_PASSWORD=        # openssl rand -hex 24 - different from root

# --- Redis (Fleet's live-query/session cache) ---
REDIS_PASSWORD=        # openssl rand -hex 24

# --- Fleet itself ---
# Encrypts sensitive data at rest (incl. the APNs cert's private key once
# uploaded) - losing this after that point means redoing Fleet's Apple
# MDM setup from scratch with Apple. Keep a copy somewhere durable
# (the Phase 5 vault is the intended home).
FLEET_SERVER_PRIVATE_KEY=   # openssl rand -hex 32

# --- Cloudflare Tunnel ---
# From Cloudflare Zero Trust dashboard: Networks > Tunnels > (your tunnel)
# > the connector token. One tunnel, two Public Hostname entries in the
# dashboard - one to http://fleet:8080, one to http://command:8080 (or
# whatever Command's actual internal port turns out to be).
TUNNEL_TOKEN=

# --- Command ---
# TODO: whatever lukep009/command's own runtime actually needs
# (database path, session secret, any third-party API keys it uses).

# --- Off-host backups (backup.sh / restore.sh) ---
# Cloudflare R2, S3-compatible - reuses the Cloudflare account this
# project already has instead of adding a third-party storage provider.
# R2 dashboard > Manage API Tokens > create one scoped to a dedicated
# bucket for this, not full-account access.
R2_ACCOUNT_ID=
R2_BUCKET=contentguard-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# restic's own encryption key for the backup contents themselves - this
# is separate from the R2 credentials above and is what actually protects
# the data at rest in the bucket. Losing it means the backups are
# unrecoverable, so it belongs in the same vault as FLEET_SERVER_PRIVATE_KEY.
RESTIC_PASSWORD=   # openssl rand -hex 32
