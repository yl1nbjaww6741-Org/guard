<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      PayloadUUID/PayloadVersion bumped (both top-level and inner payload)
      after this profile failed twice in Fleet's OS settings with the
      identical generic "the key 'Authorization or Allowed' has an
      invalid value" error, on identical content both times - the second
      failure came right after re-uploading and Resend-ing the exact
      current file, unchanged. Content itself was cross-checked against
      Apple's own device-management schema (github.com/apple/device-
      management) and confirmed correct: Authorization/Allow is valid for
      both ScreenCapture and Accessibility, and CodeRequirement matches
      `codesign -d -r-` on the real installed binary byte-for-byte. An
      identical failure on confirmed-correct content, twice, pointed at
      MDM profile installation being UUID-keyed rather than content-keyed
      - re-pushing the same PayloadUUID may just replay a cached prior
      outcome rather than genuinely re-validating. Not yet confirmed this
      was the actual cause (that requires this fresh UUID actually
      clearing in Fleet) - noted here either way so the reasoning isn't
      lost if it needs revisiting.
    -->
    <key>PayloadDisplayName</key>
    <string>ContentGuard PPPC</string>
    <key>PayloadIdentifier</key>
    <string>com.contentguard.pppc</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>2011545B-18D1-45FC-9AF3-2BEEC53E2216</string>
    <key>PayloadVersion</key>
    <integer>2</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.TCC.configuration-profile-policy</string>
            <key>PayloadIdentifier</key>
            <string>com.contentguard.pppc.payload</string>
            <key>PayloadUUID</key>
            <string>4D753AD3-B7B8-4E46-9BE8-6B85C594FE33</string>
            <key>PayloadVersion</key>
            <integer>2</integer>
            <key>Services</key>
            <dict>
                <!--
                  Authorization: Allow, not AllowStandardUserToSetSystemService.
                  The latter (used deliberately in the PHASE_2_SIGNING_TEST.md
                  test profile) requires a live, interactive user click on the
                  system's Allow dialog to complete the grant - fine for a
                  one-time manual test, but structurally incompatible with
                  ContentGuardAgent's real deployment: a headless LSUIElement
                  LaunchAgent, auto-started by launchd at login with nobody
                  necessarily present to click anything. This is the
                  documented, correct way to grant Screen Recording to a
                  background agent unattended - MDM-pushed PPPC with a
                  silent Allow, which is the one path that doesn't depend on
                  an interactive click event at all. This is very likely the
                  actual root cause of the real-Mac launchd-vs-Terminal
                  discrepancy chased at length in this session: every prior
                  grant (System Settings toggle, an interactive Terminal
                  launch) went through some form of live user-interaction
                  context, which a plain launchd bootstrap never has.
                -->
                <key>ScreenCapture</key>
                <array>
                    <dict>
                        <key>Identifier</key>
                        <string>com.contentguard.agent</string>
                        <key>IdentifierType</key>
                        <string>bundleID</string>
                        <key>CodeRequirement</key>
                        <string>identifier "com.contentguard.agent" and certificate root = H"cda6539309367d134e61fb248ba54c7e1386268e"</string>
                        <key>Authorization</key>
                        <string>Allow</string>
                    </dict>
                </array>
                <key>Accessibility</key>
                <array>
                    <dict>
                        <key>Identifier</key>
                        <string>com.contentguard.agent</string>
                        <key>IdentifierType</key>
                        <string>bundleID</string>
                        <key>CodeRequirement</key>
                        <string>identifier "com.contentguard.agent" and certificate root = H"cda6539309367d134e61fb248ba54c7e1386268e"</string>
                        <key>Authorization</key>
                        <string>Allow</string>
                    </dict>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
