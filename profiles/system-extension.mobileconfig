<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>ContentGuard System Extensions</string>
    <key>PayloadIdentifier</key>
    <string>com.contentguard.systemextensions</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>67E087E9-E4E3-4FD2-8E53-E4AC22EB2A96</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.system-extension-policy</string>
            <key>PayloadIdentifier</key>
            <string>com.contentguard.systemextensions.payload</string>
            <key>PayloadUUID</key>
            <string>44CEB2EF-0FAE-4255-B585-38EC26EF0EB1</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>ContentGuard System Extensions Payload</string>
            <!--
              Checked during Phase 1 (verified on the actual Mac, not
              guessed): `systemextensionsctl list` shows 0 extensions even
              with WARP installed and connected. Cloudflare WARP's packet
              tunnel provider runs as a plain Network (App) Extension, not
              a macOS System Extension - a different, older mechanism that
              this payload type (com.apple.system-extension-policy)
              doesn't govern. So there's nothing to pre-approve for WARP
              here; it already works without it.

              Cloudflare's Team ID, confirmed via
              `codesign -dv --verbose=4 "/Applications/Cloudflare WARP.app"`
              on the real system, for reference in case a future WARP
              version does add a System Extension: 68WVV388M8

              This payload's actual first use is Santa in Phase 3 - its
              EndpointSecurity component genuinely does use the System
              Extensions framework and needs exactly this pre-approval.
              Once Santa's installed, pull its real Team ID/bundle ID the
              same way (codesign + systemextensionsctl list, which WILL
              show an entry once Santa's extension activates) and fill in
              AllowedSystemExtensions below, then re-push.
            -->
            <key>AllowedSystemExtensions</key>
            <dict>
                <key>__SANTA_TEAM_ID__</key>
                <array>
                    <string>__SANTA_EXTENSION_BUNDLE_ID__</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
