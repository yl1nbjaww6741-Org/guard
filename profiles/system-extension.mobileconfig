<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>ContentGuard System Extensions</string>
    <key>PayloadIdentifier</key>
    <string>com.contentguard.systemextensions</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>67E087E9-E4E3-4FD2-8E53-E4AC22EB2A96</string>
    <key>PayloadVersion</key>
    <integer>2</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.system-extension-policy</string>
            <key>PayloadIdentifier</key>
            <string>com.contentguard.systemextensions.payload</string>
            <key>PayloadUUID</key>
            <string>44CEB2EF-0FAE-4255-B585-38EC26EF0EB1</string>
            <key>PayloadVersion</key>
            <integer>2</integer>
            <key>PayloadDisplayName</key>
            <string>ContentGuard System Extensions Payload</string>
            <!--
              Checked during Phase 1 (verified on the actual Mac, not
              guessed): `systemextensionsctl list` shows 0 extensions even
              with WARP installed and connected. Cloudflare WARP's packet
              tunnel provider runs as a plain Network (App) Extension, not
              a macOS System Extension - a different, older mechanism that
              this payload type (com.apple.system-extension-policy)
              doesn't govern. So there's nothing to pre-approve for WARP
              here; it already works without it.

              Cloudflare's Team ID, confirmed via
              `codesign -dv -vvvv "/Applications/Cloudflare WARP.app"`
              on the real system, for reference in case a future WARP
              version does add a System Extension: 68WVV388M8

              This payload's actual first use is Santa in Phase 3 - its
              EndpointSecurity component genuinely does use the System
              Extensions framework and needs exactly this pre-approval.

              Filled in with northpolesec/santa's real, public values
              (confirmed via northpole.dev's own deployment docs, not
              guessed - unlike the Tor Browser Team ID placeholder in
              santa-config.mobileconfig, Santa's own signing identity is
              public and stable across installs, so there's nothing
              Mac-specific to pull here): Team ID ZMCG7MLDV9,
              com.northpolesec.santa.daemon (the EndpointSecurity
              extension that actually does binary authorization - this is
              the one this profile exists for) and
              com.northpolesec.santa.netd (Santa's network extension,
              unused by Phase 3's execution-control-only setup, but
              pre-approving it is harmless if it's never activated, and
              matches northpole.dev's own reference profile rather than a
              narrower guess about what Santa needs). Once Santa's
              actually installed on the real Mac, confirm with
              `systemextensionsctl list` that both show as activated/
              enabled with no approval prompt - if a prompt appears
              anyway, this profile didn't apply cleanly and is worth
              re-checking before trusting MONITOR mode is really active.
            -->
            <key>AllowedSystemExtensions</key>
            <dict>
                <key>ZMCG7MLDV9</key>
                <array>
                    <string>com.northpolesec.santa.daemon</string>
                    <string>com.northpolesec.santa.netd</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
