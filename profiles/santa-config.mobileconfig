<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>ContentGuard Santa Configuration</string>
    <key>PayloadIdentifier</key>
    <string>com.contentguard.santa</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>B9EFAEA3-D5BE-4766-A5D3-BAABC33A4278</string>
    <key>PayloadVersion</key>
    <integer>3</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.northpolesec.santa</string>
            <key>PayloadIdentifier</key>
            <string>com.contentguard.santa.payload</string>
            <key>PayloadUUID</key>
            <string>AA383881-96D1-49E5-A703-D1B91C0F19DD</string>
            <key>PayloadVersion</key>
            <integer>3</integer>
            <key>PayloadDisplayName</key>
            <string>ContentGuard Santa Payload</string>

            <!--
              MONITOR (1), not LOCKDOWN (2) - a deliberate decision already
              made and documented in this file's README before Phase 3
              started (see the "Deliberate deviation" section there):
              standard users install freely (forceAdminPasswordForApp
              Installation=false in restrictions.mobileconfig), Phase 2's
              content-capture blocker is the real backstop against NSFW
              content regardless of which app displays it, and Santa's job
              here narrows to denylisting specific known-bad tools rather
              than gatekeeping all execution. If Santa ever switches to
              LOCKDOWN, this whole file's approach changes (StaticRules
              would need to cover everything meant to run, not just what's
              denied) - not a small edit, revisit deliberately rather than
              flipping this integer alone.
            -->
            <key>ClientMode</key>
            <integer>1</integer>

            <!--
              Phase 3 deliberately shipped with no SyncBaseURL - StaticRules
              alone was enough for "deny a short, specific list of known-bad
              tools", and standing up + trusting a sync server wasn't
              justified for that small, hand-maintained list. Phase 4's
              Cloudflare Worker (mac/README.md's Phase 4 row,
              mac/docs/PHASE_4_DASHBOARD_SETUP.md) is now real, deployed, and
              verified, so this profile points at it for real:
              - SyncBaseURL is the real deployed workers.dev URL
                (worker/wrangler.toml has no route/custom domain configured,
                so this IS the real address, not a placeholder standing in
                for one) - confirmed via the real deploy output, not guessed.
                Trailing slash matters: Santa resolves each stage
                (`preflight/<machine_id>`, etc - SNTSyncPreflight.mm's
                stageURL) as a relative URL against this string, per
                RFC 3986, same as the trailing-slash form in Santa's own
                documented example profile - built directly against
                northpolesec/santa's real source (docs/src/lib/santaconfig.ts,
                SNTSyncPreflight.mm), not the docs website, which came back
                as an empty JS-rendered page on every fetch attempt this
                session (same failure mode as the earlier buf.build/protos
                lookup - not trusted for something exact-value-sensitive).
              - SyncExtraHeaders carries the same static shared token as the
                Worker's own SANTA_SYNC_TOKEN secret (auth.ts's
                requireSyncToken) - this is the real fix for the
                unauthenticated-sync-endpoint gap found live during Phase 4
                (see this repo's git history), not optional. StaticRules
                below stay in place regardless - they're the tamper-resistant
                layer that keeps enforcing even if this Worker ever goes
                down, gets misconfigured, or the sync token is ever rotated
                without this profile being repushed in time (see
                PHASE_4_DASHBOARD_SETUP.md's "StaticRules vs. sync" section).
              CONFIRM the Worker's real SANTA_SYNC_TOKEN secret has actually
              been set to the exact value below (`wrangler secret put
              SANTA_SYNC_TOKEN`) before pushing this profile through Fleet -
              otherwise every sync attempt 503s (safe, fails closed, but
              non-functional) until they match. This value was rotated once
              (PayloadVersion 2 -> 3) before ever being pushed through Fleet -
              the value first used to verify the sync-token fix end-to-end
              had appeared in plaintext across more than one debugging
              session's transcript, so it was replaced here rather than kept
              as the value this profile ships with long-term.
            -->
            <key>SyncBaseURL</key>
            <string>https://contentguard-worker.yl1nbjaww6741-4.workers.dev/</string>
            <key>SyncExtraHeaders</key>
            <dict>
                <key>X-ContentGuard-Sync-Token</key>
                <string>6086caa49d6f375578e4fc3d8847ff1defd779b9c3560a01f91f7160a88340f3</string>
            </dict>

            <key>StaticRules</key>
            <array>
                <!--
                  Defense-in-depth allowlist for ContentGuard's own
                  binaries, signed with the self-signed "ContentGuard
                  Signing" identity (see mac/Installer/build-pkg.sh).
                  Belt-and-suspenders the same way Config.swift's
                  neverTerminateBundleIDs is: MONITOR mode means Santa isn't
                  gating ContentGuardAgent/ContentGuardDaemon from running
                  today, but an explicit ALLOWLIST rule means that stays
                  true even if ClientMode ever flips to LOCKDOWN later
                  (see the ClientMode comment above) without anyone having
                  to remember to add this rule at that point.

                  Confirmed on the real Mac via `santactl fileinfo
                  /usr/local/bin/ContentGuardAgent.app` - the SHA-256
                  under "Signing Chain: 1." (the self-signed "ContentGuard
                  Signing" leaf cert; self-signed means leaf and root are
                  the same entry). Its SHA-1 matches the hash already used
                  in profiles/pppc.mobileconfig's CodeRequirement, which
                  is a useful cross-check that it's the same certificate -
                  but Santa's CERTIFICATE rule type specifically needs the
                  SHA-256, not that SHA-1.
                -->
                <dict>
                    <key>identifier</key>
                    <string>ef2d492485a1d4b3c74946ffc72da927862af3ea0205ffdd96b96ab3617bc31f</string>
                    <key>rule_type</key>
                    <string>CERTIFICATE</string>
                    <key>policy</key>
                    <string>ALLOWLIST</string>
                </dict>

                <!--
                  Starter denylist entry #1: Tor Browser, the specific
                  example already named in mac/README.md's Phase 3 row.
                  Confirmed on the real Mac via `codesign -dv
                  "/Applications/Tor Browser.app" 2>&1 | grep
                  TeamIdentifier` - not guessed, per this file's own
                  earlier note about a wrong Team ID silently matching
                  nothing and looking like protection that isn't there.
                  Keep this list small and deliberate (see
                  profiles/README.md and this payload's own StaticRules
                  comment above) - add entries as real gaps show up, not
                  preemptively.
                -->
                <dict>
                    <key>identifier</key>
                    <string>MADPSAYN6T</string>
                    <key>rule_type</key>
                    <string>TEAMID</string>
                    <key>policy</key>
                    <string>BLOCKLIST</string>
                </dict>
            </array>

            <key>EventLogType</key>
            <string>syslog</string>
        </dict>
    </array>
</dict>
</plist>
