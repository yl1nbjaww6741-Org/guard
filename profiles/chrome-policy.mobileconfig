<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>ContentGuard Chrome Policy</string>
    <key>PayloadIdentifier</key>
    <string>com.contentguard.chrome</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>6ECA9AC0-F965-4483-8362-5B12E50392E8</string>
    <key>PayloadVersion</key>
    <integer>5</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.ManagedClient.preferences</string>
            <key>PayloadIdentifier</key>
            <string>com.contentguard.chrome.payload</string>
            <key>PayloadUUID</key>
            <string>56450B06-03B6-4F67-8CF6-95716E896A8F</string>
            <key>PayloadVersion</key>
            <integer>5</integer>
            <key>PayloadDisplayName</key>
            <string>ContentGuard Chrome Policy Payload</string>
            <key>PayloadContent</key>
            <dict>
                <key>com.google.Chrome</key>
                <dict>
                    <key>Forced</key>
                    <array>
                        <dict>
                            <key>mcx_preference_settings</key>
                            <dict>
                                <!--
                                  ExtensionInstallForcelist: force-installs
                                  each listed extension and locks it -
                                  greyed-out remove/disable controls in
                                  chrome://extensions, auto-reinstalled if
                                  somehow removed (confirmed against Chrome
                                  Enterprise's own policy docs, not
                                  guessed). This is genuinely different
                                  from ExtensionInstallBlocklist above
                                  (which controls what CAN be installed,
                                  removed entirely per 2026-08-24's
                                  loosening) - this one is about what, once
                                  installed, CANNOT be taken back off.

                                  REAL, FUNCTIONAL as of 2026-08-25 -
                                  self-hosted per the user's explicit
                                  choice (see worker/src/extensionUpdate.ts's
                                  own doc comment: this project's own
                                  Cloudflare infra, not the Chrome Web
                                  Store). Extension ID and update.xml
                                  location both confirmed end-to-end
                                  before landing here - not just built,
                                  a real HTTPS GET against the live
                                  .crx endpoint returned 200 with a
                                  byte-exact content-length match
                                  against the locally-built file
                                  (93339510 bytes). This is the
                                  self-hosted path from this comment's
                                  own earlier note: a self-hosted update
                                  manifest XML the extension_id's
                                  update_url points to, serving the
                                  signed .crx - worker/src/extensionUpdate.ts
                                  serves both, backed by R2
                                  (wrangler.toml's EXTENSION_ASSETS
                                  binding).

                                  Re-package + re-upload whenever
                                  chrome-extension/ actually changes -
                                  see chrome-extension/build/README.md.
                                  The extension_id below is permanent
                                  (tied to build/dist/key.pem, which the
                                  extension maintainer holds outside
                                  this repo) and does NOT change on a
                                  re-package; only the .crx content and
                                  extensionUpdate.ts's EXTENSION_VERSION
                                  constant do.
                                -->
                                <key>ExtensionInstallForcelist</key>
                                <array>
                                    <string>pdhcmfmgdicpkanpigjpgenhhbbollpk;https://panel.lukep009.download/extension/update.xml</string>
                                </array>
                                <!--
                                  DeveloperToolsAvailability: 1 (Allowed),
                                  not 2 (Disallowed) - deliberately
                                  loosened 2026-08-25, explicit user
                                  choice ("Apply immediately"), same
                                  informed-override precedent as
                                  2026-08-24's ExtensionInstallBlocklist/
                                  BrowserSignin change (see this project's
                                  docs, "Loosening MDM profile
                                  restrictions"). Real, immediate need:
                                  Chrome's own documented behavior for
                                  DeveloperToolsAvailability=2 is that it
                                  ALSO disables "Developer mode" on the
                                  chrome://extensions page, not just the
                                  DevTools panel - which blocked "Load
                                  unpacked", the only way to test
                                  chrome-extension/ before it's packaged
                                  and force-installed for real via
                                  ExtensionInstallForcelist above.

                                  Pushed DIRECTLY through Fleet's own UI
                                  (Controls -> OS settings -> Custom
                                  settings), not this dashboard's own
                                  config-profile upload feature - that
                                  feature now unconditionally ratchets
                                  every profile change 24h+password, no
                                  exceptions (a deliberate fix, see this
                                  project's docs' "The gap above is now
                                  closed" section) - so an immediate push
                                  can only ever happen outside this
                                  dashboard, via Fleet's own native UI/API
                                  directly, which this Worker has no
                                  ability to gate at all. Named
                                  explicitly, not hidden: this is a real,
                                  permanent limit of what the ratchet can
                                  cover, not a bug in it.

                                  TEMPORARY - re-tighten back to 2 once
                                  chrome-extension/ is packaged/signed and
                                  force-installed via ExtensionInstallForcelist
                                  above (which doesn't need Developer mode
                                  at all, since Chrome installs a policy-
                                  forced extension itself, not through the
                                  user-facing "Load unpacked" flow this
                                  loosening exists only to unblock).
                                -->
                                <key>DeveloperToolsAvailability</key>
                                <integer>1</integer>
                                <key>IncognitoModeAvailability</key>
                                <integer>1</integer>
                                <key>BrowserGuestModeEnabled</key>
                                <false/>
                                <!--
                                  ExtensionInstallBlocklist removed
                                  entirely (was ["*"], blocking all
                                  installs) rather than set to an empty
                                  array - per Chrome's own real policy
                                  semantics (confirmed against Chrome
                                  Enterprise's own policy docs, not
                                  guessed), an unset policy is the actual
                                  "no restriction" state, same meaning as
                                  removing it. Deliberate, informed user
                                  request, not a default/oversight -
                                  bypasses this project's ratchet
                                  mechanism, which doesn't cover MDM
                                  profile edits at all (see
                                  mac/docs/PHASE_4_DASHBOARD_SETUP.md's
                                  "Loosening MDM profile restrictions"
                                  section). Real gap this reopens: this is
                                  the mechanism that would let a
                                  proxy/VPN/content-unblocking extension
                                  in - accepted as a known, named gap.
                                -->
                                <key>DnsOverHttpsMode</key>
                                <string>off</string>
                                <!--
                                  BrowserSignin: 1 (Enable), not 0
                                  (Disable) - confirmed against Chrome
                                  Enterprise's own real policy values, not
                                  guessed: 0 disables sign-in entirely, 1
                                  allows but doesn't force it, 2 forces it.
                                  Same deliberate, informed loosening as
                                  the extension-install change above.
                                -->
                                <key>BrowserSignin</key>
                                <integer>1</integer>
                            </dict>
                        </dict>
                    </array>
                </dict>
            </dict>
        </dict>
    </array>
</dict>
</plist>
