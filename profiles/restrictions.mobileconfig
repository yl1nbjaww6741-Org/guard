<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>ContentGuard Restrictions</string>
    <key>PayloadIdentifier</key>
    <string>com.contentguard.restrictions</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>02C634B6-1924-4ADC-9E63-600C318508A9</string>
    <key>PayloadVersion</key>
    <integer>3</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadIdentifier</key>
            <string>com.contentguard.restrictions.payload</string>
            <key>PayloadUUID</key>
            <string>9E25880A-CCAF-4034-B1BC-1AF9D59008A5</string>
            <key>PayloadVersion</key>
            <integer>3</integer>
            <key>PayloadDisplayName</key>
            <string>ContentGuard Restrictions Payload</string>

            <key>allowCloudPrivateRelay</key>
            <false/>
            <key>allowEraseContentAndSettings</key>
            <false/>
            <!--
              Deliberately true, not the original spec's false - explicit,
              informed user request (not a default/oversight): asked to be
              loosened immediately, bypassing this project's own ratchet
              mechanism (which doesn't cover MDM profile edits at all -
              see mac/docs/PHASE_4_DASHBOARD_SETUP.md's "Loosening MDM
              profile restrictions" section for the tradeoff this accepts
              and why it wasn't extended to cover this instead). Real
              side-channel this reopens: AirDrop can move files (including
              installers) onto this Mac without going through anything
              Santa or Gateway ever sees - accepted as a known, named gap,
              not an unnoticed one.
            -->
            <key>allowAirDrop</key>
            <true/>
            <key>allowLocalUserCreation</key>
            <false/>
            <key>allowAccountModification</key>
            <false/>
            <key>allowUIConfigurationProfileInstallation</key>
            <false/>
            <key>allowStartupDiskModification</key>
            <false/>
            <!--
              Deliberately false, not the original spec's true - see
              profiles/README.md. Standard users (post-Phase 5) install
              freely; Santa (Phase 3, kept in MONITOR/blocklist mode per
              a separate deliberate decision) governs execution, and the
              Phase 2 content-capture blocker catches NSFW content
              regardless of which app displayed it, matching how the
              Android app already works. Known gap this combination
              doesn't cover: a freely-installed tool that doesn't display
              NSFW content but instead targets the enforcement stack
              itself (killing the daemon, revoking Screen Recording,
              etc.) - mitigated by Phase 2's daemon being designed
              tamper-resistant on its own (fails closed, escalates on
              kill-loops), not by this key or by Santa.
            -->
            <key>forceAdminPasswordForAppInstallation</key>
            <false/>
            <key>allowScreenshotsAndScreenRecording</key>
            <false/>
            <key>forceBypassScreenCaptureAlert</key>
            <true/>
        </dict>
    </array>
</dict>
</plist>
