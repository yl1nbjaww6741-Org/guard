<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>ContentGuard Restrictions</string>
    <key>PayloadIdentifier</key>
    <string>com.contentguard.restrictions</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>02C634B6-1924-4ADC-9E63-600C318508A9</string>
    <key>PayloadVersion</key>
    <integer>5</integer>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadIdentifier</key>
            <string>com.contentguard.restrictions.payload</string>
            <key>PayloadUUID</key>
            <string>9E25880A-CCAF-4034-B1BC-1AF9D59008A5</string>
            <key>PayloadVersion</key>
            <integer>5</integer>
            <key>PayloadDisplayName</key>
            <string>ContentGuard Restrictions Payload</string>

            <key>allowCloudPrivateRelay</key>
            <false/>
            <key>allowEraseContentAndSettings</key>
            <false/>
            <!--
              Deliberately true, not the original spec's false - explicit,
              informed user request (not a default/oversight): asked to be
              loosened immediately, bypassing this project's own ratchet
              mechanism (which doesn't cover MDM profile edits at all -
              see mac/docs/PHASE_4_DASHBOARD_SETUP.md's "Loosening MDM
              profile restrictions" section for the tradeoff this accepts
              and why it wasn't extended to cover this instead). Real
              side-channel this reopens: AirDrop can move files (including
              installers) onto this Mac without going through anything
              Santa or Gateway ever sees - accepted as a known, named gap,
              not an unnoticed one.
            -->
            <key>allowAirDrop</key>
            <true/>
            <key>allowLocalUserCreation</key>
            <false/>
            <key>allowAccountModification</key>
            <false/>
            <key>allowUIConfigurationProfileInstallation</key>
            <false/>
            <key>allowStartupDiskModification</key>
            <false/>
            <!--
              Deliberately false, not the original spec's true - see
              profiles/README.md. Standard users (post-Phase 5) install
              freely; Santa (Phase 3, kept in MONITOR/blocklist mode per
              a separate deliberate decision) governs execution, and the
              Phase 2 content-capture blocker catches NSFW content
              regardless of which app displayed it, matching how the
              Android app already works. Known gap this combination
              doesn't cover: a freely-installed tool that doesn't display
              NSFW content but instead targets the enforcement stack
              itself (killing the daemon, revoking Screen Recording,
              etc.) - mitigated by Phase 2's daemon being designed
              tamper-resistant on its own (fails closed, escalates on
              kill-loops), not by this key or by Santa.
            -->
            <key>forceAdminPasswordForAppInstallation</key>
            <false/>
            <key>allowScreenshotsAndScreenRecording</key>
            <false/>
            <key>forceBypassScreenCaptureAlert</key>
            <true/>
            <!--
              blacklistedAppBundleIDs: added 2026-08-25, explicit user
              request - corrected mid-edit from an initial "block
              everything but Safari" misreading to what was actually
              meant: block every other browser and route everything
              through Chrome specifically, because Chrome is "the
              hardened one" - the one carrying the mandatory AI-blocker
              extension via chrome-policy.mobileconfig's
              ExtensionInstallForcelist (this session's own build,
              confirmed live 2026-08-25). Safari has no equivalent
              extension/enforcement built for it in this project, so it
              gets blocked here along with everything else - this list
              now makes chrome-policy.mobileconfig's whole force-install
              build the one thing standing between this Mac and a
              browser with no content filtering at all, rather than
              redundant with it.

              Real limitation, stated up front rather than implied:
              com.apple.applicationaccess only supports blocking
              specific bundle IDs you enumerate - there is no "block
              everything in the browser category" primitive. The
              alternative that WOULD be a true "only X can run" -
              whitelistedAppBundleIDs - was deliberately not used here:
              it flips this from "block browsers" into "block every app
              on the system not explicitly listed" (Mail, Terminal,
              Xcode, Slack, the lot), a far bigger and more disruptive
              lockdown than what was asked for. So this list is a
              best-effort enumeration of known desktop browser bundle
              IDs (each vendor's standard signed-build identifier, not
              guessed) - a new browser, a renamed fork, or an unlisted
              rebrand released after this was written won't be caught
              until its real bundle ID is added. MUST be verified on
              the real Mac after this profile is pushed, not assumed:
              try launching each installed non-Chrome browser (Safari
              included) and confirm each is actually refused; for
              anything that still launches, get its real ID with
              `mdls -name kMDItemCFBundleIdentifier -r /Applications/X.app`
              and add it here.

              Chrome's own beta/dev/canary channels are included below,
              not exempted alongside stable - each is a separate app
              with its own bundle ID and its own, unmanaged preferences
              domain, so none of them actually carry the
              ExtensionInstallForcelist enforcement (that policy is
              scoped to com.google.Chrome, the managed stable channel,
              in chrome-policy.mobileconfig's PayloadContent dict key).
              Only plain com.google.Chrome is the hardened one and stays
              off this list.

              Deepened 2026-08-25 (same request, "go deeper... block all
              the others") with more browsers plus torrent/P2P clients
              (see that section's own comment below). Confidence isn't
              uniform across this list and that's stated here rather
              than smoothed over: everything above this note plus the
              handful of well-established names newly added (iCab,
              SeaMonkey, Naver Whale, Sidekick, Wavebox, Blisk) use each
              vendor's standard, long-documented signed-build identifier.
              A separate tier of real, currently-used Mac browsers exists
              whose exact bundle ID isn't confident enough to assert as
              fact here rather than guessed and silently wrong - Zen
              Browser, Floorp, Maxthon, Epic Privacy Browser, Min
              Browser, and Polarity are all real and worth checking for
              on this Mac specifically (`mdls -name
              kMDItemCFBundleIdentifier -r /Applications/X.app` on
              whatever's actually installed) and adding once confirmed,
              rather than included here on a guess.
            -->
            <key>blacklistedAppBundleIDs</key>
            <array>
                <!-- Apple's own browser - deliberately blocked, see this
                     comment's opening paragraph -->
                <string>com.apple.Safari</string>
                <string>com.apple.SafariTechnologyPreview</string>
                <!-- Chromium family (all except the hardened stable
                     Chrome channel itself) -->
                <string>com.google.Chrome.beta</string>
                <string>com.google.Chrome.dev</string>
                <string>com.google.Chrome.canary</string>
                <string>org.chromium.Chromium</string>
                <string>com.microsoft.edgemac</string>
                <string>com.microsoft.edgemac.Beta</string>
                <string>com.microsoft.edgemac.Dev</string>
                <string>com.microsoft.edgemac.Canary</string>
                <string>com.brave.Browser</string>
                <string>com.brave.Browser.beta</string>
                <string>com.brave.Browser.nightly</string>
                <string>com.operasoftware.Opera</string>
                <string>com.operasoftware.OperaGX</string>
                <string>com.operasoftware.OperaNext</string>
                <string>com.vivaldi.Vivaldi</string>
                <string>company.thebrowser.Browser</string>
                <string>company.thebrowser.dia</string>
                <string>ru.yandex.desktop.yandex-browser</string>
                <!-- Firefox family -->
                <string>org.mozilla.firefox</string>
                <string>org.mozilla.firefoxdeveloperedition</string>
                <string>org.mozilla.nightly</string>
                <string>net.waterfox.waterfox</string>
                <string>io.gitlab.librewolf-community</string>
                <string>org.torproject.torbrowser</string>
                <!-- Independent / other engines -->
                <string>com.duckduckgo.macos.browser</string>
                <string>com.kagi.kagimacOS</string>
                <string>de.iCab.iCab</string>
                <string>org.mozilla.seamonkey</string>
                <string>com.naver.whale</string>
                <string>com.pushplaybutton.sidekick</string>
                <string>com.wavebox.desktop</string>
                <string>com.blisk.Blisk</string>
                <!-- Torrent / P2P file-sharing clients - not browsers,
                     added 2026-08-25 same request ("go as deep as you
                     can... block all the others"), same mechanism
                     (blacklistedAppBundleIDs doesn't care what kind of
                     app it blocks). Real, separate gap this does NOT
                     close, stated plainly rather than implied: this
                     blocks the desktop CLIENT apps, not the BitTorrent
                     protocol itself or magnet: links opened some other
                     way (a CLI client, a script, a torrent site's
                     browser-based WebTorrent streaming). Network-level
                     blocking (tracker/DHT ports, magnet: URI handling)
                     would need a Gateway/firewall rule, not this
                     payload - not attempted here since it wasn't asked
                     for and risks false-positives on unrelated UDP/TCP
                     traffic. -->
                <string>org.transmissionbt.Transmission</string>
                <string>org.qbittorrent.qbittorrent</string>
                <string>org.deluge-torrent.deluge</string>
                <string>com.bittorrent.uTorrent</string>
                <string>com.bittorrent.BitTorrent</string>
                <string>com.vuze.Vuze</string>
                <string>com.eltima.Folx</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
